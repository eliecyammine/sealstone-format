#!/bin/sh
# Sealstone workflow: main is release-only and receives changes by pull request.
# Work lands on dev. Neither branch is ever deleted.
#
# Bypass for a genuine emergency:  git push --no-verify

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        echo ""
        echo "  ✗ Direct push to main is blocked."
        echo ""
        echo "    Push to dev, then open a pull request into main:"
        echo "      git push origin dev"
        echo "      gh pr create --base main --head dev"
        echo ""
        exit 1
      fi
      ;;
  esac
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    echo ""
    echo "  ✗ Branch deletion is blocked. main and dev are permanent."
    echo ""
    exit 1
  fi
done
exit 0
