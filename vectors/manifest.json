    {
      "id": "07-hostile-parameters",
      "description": "Files demanding resources outside the permitted ranges. Each must be refused before any memory is allocated and before the key derivation function is called. An implementation that attempts these will be terminated by the operating system, which a user cannot distinguish from data loss.",
      "kind": "reject-before-allocation",
      "passphraseUtf8Hex": "636f727265637420686f727365206261747465727920737461706c65",
      "limits": {
        "kdfMemoryKiB": {
          "min": "8 * parallelism",
          "max": 1048576
        },
        "kdfIterations": {
          "min": 1,
          "max": 16
        },
        "kdfParallelism": {
          "min": 1,
          "max": 16
        }
      },
      "cases": [
        {
          "name": "memory-1TiB",
          "file": "07-hostile-parameters/memory-1TiB.seal",
          "reason": "memory above the permitted ceiling"
        },
        {
          "name": "memory-zero",
          "file": "07-hostile-parameters/memory-zero.seal",
          "reason": "memory below the permitted floor"
        },
        {
          "name": "iterations-huge",
          "file": "07-hostile-parameters/iterations-huge.seal",
          "reason": "iteration count above the permitted ceiling"
        },
        {
          "name": "iterations-zero",
          "file": "07-hostile-parameters/iterations-zero.seal",
          "reason": "iteration count of zero"
