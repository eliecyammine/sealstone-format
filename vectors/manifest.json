    {
      "id": "12-identifiers",
      "description": "Identifiers of every kind, the malformed ones a reader must reject, and the transcription substitutions Crockford Base32 requires it to accept. The kind prefix is matched exactly and is always lowercase; the body is decoded leniently, because the person retyping one is a keeper working from paper.",
      "kind": "identifiers",
      "bodyBits": 128,
      "bodyLength": 26,
      "kinds": {
        "timeOrdered": [
          "vlt",
          "acc",
          "itm",
          "lnk"
